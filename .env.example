# Copy to .env for local Docker-based Agent Producer work.

# Docker writes workspace files as the host user.
HOST_UID=1000
HOST_GID=1000

# Remotion Studio port and local-only generated artifact root.
STUDIO_PORT=3001
AI_VIDEO_STUDIO_ARTIFACT_ROOT="/workspace/out"

# VoxCPM is the only supported narration provider for new Producer work.
VOXCPM_TTS_BASE_URL="http://192.168.50.6:8810"
# Empty endpoint values are derived from the base URL and clone mode.
VOXCPM_TTS_ENDPOINT=""
VOXCPM_TTS_CLONE_MODE="clone_with_prompt"
VOXCPM_TTS_CLONE_ENDPOINT=""
VOXCPM_TTS_CONTROLLABLE_CLONE_ENDPOINT=""
VOXCPM_TTS_HIGH_FIDELITY_CLONE_ENDPOINT=""
VOXCPM_TTS_CONTROL=""
VOXCPM_TTS_CFG_VALUE="2"
VOXCPM_TTS_INFERENCE_TIMESTEPS="10"
VOXCPM_TTS_NORMALIZE="true"
VOXCPM_TTS_DENOISE="false"
VOXCPM_TTS_RETRY_BADCASE="true"
VOXCPM_TTS_SAVE="false"
VOXCPM_TTS_FILENAME_PREFIX="ai-video-studio"
VOXCPM_TTS_TIMEOUT_MS="180000"
