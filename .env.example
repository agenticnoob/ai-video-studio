# Unified local configuration template.
# Copy this file to `.env`; Docker Compose and the Next app both use `.env`.
# `.env.local` is still tolerated by Next.js, but new local setup should not
# need a separate Docker env file or app env file.

# 宿主机 uid/gid。Docker 以当前用户身份写工作区文件，避免 root 属主污染。
HOST_UID=1000
HOST_GID=1000
# dev web 服务对外端口。宿主机访问 Next dev server 用这个端口。
APP_PORT=3000
# studio/remotion 预览服务对外端口。
STUDIO_PORT=3001
# F5 HTTP 服务暴露到宿主机的绑定地址和端口。默认只绑定本机。
F5_TTS_HOST_BIND=127.0.0.1
F5_TTS_HOST_PORT=7865
# 独立 prod web 服务的宿主机绑定地址和端口。
PROD_APP_BIND=127.0.0.1
PROD_APP_PORT=10001

# 私人小团队部署的重任务保护。
# 这些配置只限制当前 Next.js web 进程里的重任务并发，不依赖数据库，
# 也不会记录任务历史、进度、取消状态。多副本/多容器 web 部署时，
# 每个副本都会有自己的内存限流器；如需全局限流，需要外部锁或任务队列。
#
# AI_VIDEO_STUDIO_RENDER_CONCURRENCY：/api/render 本地导出的最大并发数。
# 建议保持 1，因为 Remotion/Chrome 很吃资源，私人部署当前默认也不需要并发导出。
AI_VIDEO_STUDIO_RENDER_CONCURRENCY="1"
#
# AI_VIDEO_STUDIO_GENERATION_CONCURRENCY：生成入口的最大并发数。
# 覆盖默认 staged 生成 /api/generate/staged，也覆盖旧 fallback /api/generate。
# 私人小团队建议保持 1，避免多个请求同时打 DeepSeek、F5 和模板编译链路。
AI_VIDEO_STUDIO_GENERATION_CONCURRENCY="1"
#
# AI_VIDEO_STUDIO_TTS_CONCURRENCY：Next 侧 TTS provider 合成最大并发数。
# 覆盖 staged 内部 TTS 和单独 /api/tts。真实 F5/GPU 模式建议保持 1。
AI_VIDEO_STUDIO_TTS_CONCURRENCY="1"
#
# AI_VIDEO_STUDIO_BUSY_MODE：
# - reject：任务池已满时立即返回 HTTP 429，推荐默认值，用户能明确知道稍后重试。
# - queue：任务池已满时在当前 HTTP 请求里等待，不是持久队列；刷新页面会丢失等待。
AI_VIDEO_STUDIO_BUSY_MODE="reject"
#
# AI_VIDEO_STUDIO_QUEUE_TIMEOUT_MS：仅在 busy mode 为 queue 时生效。
# 超过该时间仍未拿到执行名额时返回 429。
AI_VIDEO_STUDIO_QUEUE_TIMEOUT_MS="300000"

# 产物目录。
# AI_VIDEO_STUDIO_ARTIFACT_ROOT：统一产物根目录。
# 代码会固定派生三个子目录：
# - renders/：视频导出目录；每次导出生成唯一 render 文件
# - tts/：Next 侧 narration/TTS 音频目录；字幕 sidecar 也会写在这里
# - voice-references/：页面上传的声音克隆参考音频目录
# Docker 工作流默认使用容器内共享绝对路径，这样 Next / Remotion / F5 对文件路径的
# 认知一致。如果你明确走宿主机直跑 Next，再按需改成相对路径如 out。
AI_VIDEO_STUDIO_ARTIFACT_ROOT="/workspace/out"

# 预留给 Remotion 云渲染 / AWS 兼容场景；当前本地 Docker 工作流通常留空。
REMOTION_AWS_ACCESS_KEY_ID=""
REMOTION_AWS_SECRET_ACCESS_KEY=""

# DeepSeek 文本生成配置。/api/generate/staged 的 storyboard planner 和
# selected-template compiler 都走 DeepSeek。更多细节见 docs/providers/deepseek.md。
# DEEPSEEK_API_KEY：DeepSeek API key；为空时真实生成会直接报配置错误。
DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL：文本/规划/编译使用的 DeepSeek 模型；默认 deepseek-chat。
DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_BASE_URL：可选 DeepSeek API base URL；一般不用改，除非走自建网关。
DEEPSEEK_BASE_URL=""

# TTS provider 选择。
# VoxCPM is the default Agent Producer TTS provider. With voiceClone.enabled,
# VoxCPM uses /clone_with_prompt by default. Set TTS_PROVIDER=f5-tts only when
# you intentionally want F5.
# - voxcpm：使用外部 `/data/projects/labs/voxcpm-api` 服务；普通合成走 /tts，
#   voiceClone.enabled 默认走 /clone_with_prompt。
# - f5-tts：显式使用项目内 F5-TTS provider fallback。
TTS_PROVIDER="voxcpm"

# 可选本地/容器 F5-TTS runtime；仅在 TTS_PROVIDER=f5-tts 时作为显式 fallback 使用。
# 真实用户生成请用 scripts/f5-tts-real.sh
# 启动 GPU overlay；普通 docker-compose.f5.yml 默认是 contract-smoke，只用于
# HTTP 合同验证，不代表真实 F5 音频时长。
# F5_TTS_BASE_URL：Next app 访问 F5 服务的 base URL；Docker 内一般是
# http://f5-tts:7865，宿主机 smoke 一般是 http://127.0.0.1:7865。
F5_TTS_BASE_URL=""
# F5_TTS_ENDPOINT：F5 合成接口；为空时默认 `${F5_TTS_BASE_URL}/synthesize`。
F5_TTS_ENDPOINT=""
# F5_TTS_VOICE_ID：传给 F5 adapter 的默认声音 id；当前主要用于统一字段。
F5_TTS_VOICE_ID="default"
# F5_TTS_FORMAT：Next 侧保存到 AI_VIDEO_STUDIO_ARTIFACT_ROOT/tts 的音频格式，F5 推荐 wav。
F5_TTS_FORMAT="wav"
# F5_TTS_REFERENCE_AUDIO：请求级参考音频路径，必须是 F5 容器能访问的路径。
F5_TTS_REFERENCE_AUDIO=""
# F5_TTS_SERVICE_MODE：F5 runtime 模式。f5 会加载本地 checkpoint 做真实合成；
# contract-smoke 只返回测试音频，听起来会像持续“嘟”声。
F5_TTS_SERVICE_MODE="f5"
# F5_TTS_HOST_BIND / F5_TTS_HOST_PORT：F5 HTTP 服务暴露到宿主机的绑定地址和端口，
# 已在文件顶部定义。默认只绑定本机，避免把调试入口直接暴露到局域网。
# F5_TTS_MODEL_PATH：F5 checkpoint 在容器内的路径。
F5_TTS_MODEL_PATH="/models/f5-tts/model_1250000.safetensors"
# F5_TTS_VOCAB_PATH：F5 vocab 文件在容器内的路径。
F5_TTS_VOCAB_PATH="/models/f5-tts/vocab.txt"
# F5_TTS_VOCODER_PATH：Vocos vocoder 在容器内的路径。
F5_TTS_VOCODER_PATH="/models/f5-tts/vocos-mel-24khz"
# F5_TTS_ALLOW_VOCODER_DOWNLOAD：vocoder 缺失时是否允许运行时下载；本机建议 false。
F5_TTS_ALLOW_VOCODER_DOWNLOAD="false"
# F5_TTS_DEVICE：F5 运行设备；GPU overlay 默认 cuda，CPU 仅建议诊断使用。
F5_TTS_DEVICE=""
# F5_TTS_NFE_STEP：F5 推理步数；越高可能更稳但更慢，默认 16。
F5_TTS_NFE_STEP="16"
# F5_TTS_DEFAULT_REFERENCE_AUDIO：runtime 默认参考音频；请求未传 referenceAudio 时使用。
F5_TTS_DEFAULT_REFERENCE_AUDIO=""
# F5_TTS_DEFAULT_REFERENCE_TEXT：默认参考音频对应文本；自定义音色时必须和音频内容匹配。
F5_TTS_DEFAULT_REFERENCE_TEXT=""
# F5_TTS_RUNTIME_CONCURRENCY：F5 runtime 服务自身 /synthesize 的最大并发数。
# 这是 Python/FastAPI 服务内的保护，防止有人绕过 Next 直接请求 F5 服务。
# 真实 GPU 模式建议保持 1；contract-smoke 虽然可以更高，但小团队通常没必要调大。
F5_TTS_RUNTIME_CONCURRENCY="1"

# VoxCPM 本地 TTS 服务。当前个人服务默认在 ubuntu host 的 127.0.0.1:8810。
# 如果 Next 跑在 Docker 容器里，优先验证容器是否能访问该地址；必要时使用
# host.docker.internal、host-network override，或调整 VoxCPM 服务监听策略。
VOXCPM_TTS_BASE_URL="http://127.0.0.1:8810"
# VOXCPM_TTS_ENDPOINT：VoxCPM 合成接口；为空时默认 `${VOXCPM_TTS_BASE_URL}/tts`。
VOXCPM_TTS_ENDPOINT=""
# VOXCPM_TTS_CLONE_MODE：voiceClone.enabled 时的 VoxCPM clone 接口。
# clone_with_prompt 默认使用 `/clone_with_prompt`；设为 clone 可兼容 `/clone`。
VOXCPM_TTS_CLONE_MODE="clone_with_prompt"
# VOXCPM_TTS_CLONE_ENDPOINT：可选 clone 接口覆盖；为空时按 clone mode 派生。
VOXCPM_TTS_CLONE_ENDPOINT=""
# VOXCPM_TTS_CONTROL：VoxCPM voice design 控制语，例如“年轻女性，温柔，略带微笑”。
VOXCPM_TTS_CONTROL=""
# VOXCPM_TTS_CFG_VALUE：VoxCPM cfg_value，默认 2。
VOXCPM_TTS_CFG_VALUE="2"
# VOXCPM_TTS_INFERENCE_TIMESTEPS：VoxCPM 推理步数，默认 10。
VOXCPM_TTS_INFERENCE_TIMESTEPS="10"
# VOXCPM_TTS_NORMALIZE：是否 normalize，默认 true。
VOXCPM_TTS_NORMALIZE="true"
# VOXCPM_TTS_DENOISE：是否 denoise，默认 false。
VOXCPM_TTS_DENOISE="false"
# VOXCPM_TTS_SAVE：是否让 VoxCPM 服务端也保存一份输出；项目自身仍会保存到 out/tts。
VOXCPM_TTS_SAVE="false"
# VOXCPM_TTS_FILENAME_PREFIX：VoxCPM 服务端保存文件前缀，仅 VOXCPM_TTS_SAVE=true 时明显有用。
VOXCPM_TTS_FILENAME_PREFIX="ai-video-studio"

# /api/render 本地导出时，Remotion 下载 /api/tts/assets/... 等 route media
# 使用的 Next app origin。默认应保持容器/进程自己可访问的 3000。
# 即使 docker-compose.prod.yml 对外暴露的是 10001，容器内导出仍应使用
# http://127.0.0.1:3000，避免在容器内回连宿主机端口导致 ECONNREFUSED。
AI_VIDEO_STUDIO_RENDER_ASSET_ORIGIN="http://127.0.0.1:3000"
