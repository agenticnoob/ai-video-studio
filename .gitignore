public/generated/

# AppleDouble (macOS SMB access artifact)
._*

# CodeGraph local index (regenerated by `codegraph index`)
.codegraph/

# Local visual brainstorming companion sessions.
.superpowers/
.claude/

# User-owned reusable-asset inbox and atomic transaction staging.
.producer-assets/

# Throwaway ad-hoc research / verification scripts — never committed.
# Keep them out of the repo: they're noisy, time-bounded, and reference the
# live API. Self-built task harnesses (e.g. scripts-tmp-tool-calling-verify.mjs).
/scripts-tmp-*.mjs
/scripts-tmp-*.ts

# Local orchestration/debug evidence.
.debug-journal.md
.playwright-cli/
output/
.omo/
