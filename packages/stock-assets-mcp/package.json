{
  "name": "stock-assets-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "stock-assets-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:compile": "rm -rf .test-dist && tsc -p tsconfig.test.json",
    "test": "npm run build && npm run test:compile && node --test .test-dist/tests/*.test.js",
    "lint": "eslint src tests",
    "verify:pack": "npm pack --dry-run --json",
    "start": "node dist/cli.js",
    "smoke:live": "npm run test:compile && STOCK_ASSETS_LIVE_PEXELS=1 node --test .test-dist/tests/live-pexels.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "sharp": "0.34.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "20.12.14",
    "eslint": "9.19.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  }
}
